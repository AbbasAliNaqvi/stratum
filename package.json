{
  "name": "stratum",
  "version": "0.1.0",
  "private": true,
  "description": "STRATUM — AI-Native Automation & Orchestration Platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "stratum": "./apps/cli/bin/stratum.js"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@stratum/control-plane",
    "dev:web": "npm run dev --workspace=@stratum/web",
    "build:web": "npm run build --workspace=@stratum/web",
    "start": "npm run start --workspace=@stratum/control-plane",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}